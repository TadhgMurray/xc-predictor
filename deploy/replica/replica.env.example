# deploy/replica/replica.env.example
#
# Copy to /etc/racecast-replica.env on BOTH servers, fill in, chmod 600.
# The two files differ only in the SELF/PEER lines (swap them). Nothing here
# says which box is the primary: that is whichever one is not in recovery,
# and it changes at a switchover without editing this file.
#
#   docs/REPLICA-PLAN.md has the order to run things in.

# this box and the other one: "a" is today's server, "b" the new one
RC_SELF_NAME=a
RC_PEER_NAME=b

# public addresses (WireGuard runs between them; nothing else does)
RC_SELF_PUBLIC_IP=203.0.113.10
RC_PEER_PUBLIC_IP=203.0.113.20

# the private tunnel: a = 10.77.0.1, b = 10.77.0.2
RC_WG_IF=wg0
RC_WG_PORT=51820
RC_SELF_WG=10.77.0.1
RC_PEER_WG=10.77.0.2
# the OTHER box's WireGuard public key: wg_setup.sh prints each box's own
RC_PEER_WG_PUBKEY=

# Postgres
RC_PG_MAJOR=18
RC_PG_CLUSTER=main
RC_PG_PORT=5432
RC_DB_NAME=xc_predictor
# the streaming user; the SAME password on both boxes (openssl rand -base64 24)
RC_REPL_USER=replicator
RC_REPL_PASSWORD=
# a standby that is down keeps WAL on the primary through its slot; past this
# much the slot is let go (the standby then needs standby_build.sh --rebuild)
# instead of the primary's disk filling up
RC_MAX_SLOT_WAL_KEEP=200GB

# the base backup: cap its read rate on the primary (empty = no cap; 100M is
# ~100 MB/s, about what a 1 Gbit/s link carries anyway), and compress it on
# the primary for the wire (empty = uncompressed)
RC_BB_MAX_RATE=
RC_BB_COMPRESS=server-zstd:level=3
RC_BB_CHECKPOINT=fast

# the site on a standby box reads its own replica and writes to the primary;
# this is how far behind (seconds) the replica may be before its reads go to
# the primary instead (scripts/read_routing.py)
RC_READ_MAX_LAG_S=300

# origin health (origin_health.py) for Cloudflare's monitor
RC_HEALTH_PORT=8099
